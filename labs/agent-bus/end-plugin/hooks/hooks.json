{
  "hooks": {
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const j=JSON.parse(d||'{}');require('fs').appendFileSync(process.env.CLAUDE_PROJECT_DIR+'/session-end.log',JSON.stringify({reason:j.reason,session:j.session_id})+'\\n')})\"" } ] }
    ]
  }
}
